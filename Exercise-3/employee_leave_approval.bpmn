<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_LeaveApproval" targetNamespace="http://xyz-corp.example/leave-approval">
  <bpmn:process id="employee-leave-approval" name="Employee Leave Request Approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LeaveRequest" name="Leave request received"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitRequest" name="Submit leave request"><bpmn:extensionElements><zeebe:formDefinition formKey="camunda-forms:bpmn:leave-request-form"/></bpmn:extensionElements><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_CheckBalance" name="Retrieve leave balance"><bpmn:extensionElements><zeebe:taskDefinition type="check-leave-balance" retries="3"/></bpmn:extensionElements><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_LeaveDecision" name="Evaluate leave rules (DMN)" implementation="##DMN"><bpmn:extensionElements><zeebe:calledDecision decisionId="leave-eligibility-routing" resultVariable="leaveDecision"/></bpmn:extensionElements><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_LeaveOutcome" name="Decision outcome" gatewayDirection="Diverging"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_Insufficient</bpmn:outgoing><bpmn:outgoing>Flow_Auto</bpmn:outgoing><bpmn:outgoing>Flow_Manager</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyInsufficient" name="Notify insufficient balance"><bpmn:extensionElements><zeebe:taskDefinition type="notify-insufficient-balance" retries="3"/></bpmn:extensionElements><bpmn:incoming>Flow_Insufficient</bpmn:incoming><bpmn:outgoing>Flow_InsufficientEnd</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Insufficient" name="Rejected – insufficient balance"><bpmn:incoming>Flow_InsufficientEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="Task_ManagerReview" name="Review leave request (Manager)"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="managers"/></bpmn:extensionElements><bpmn:incoming>Flow_Manager</bpmn:incoming><bpmn:outgoing>Flow_ManagerDecision</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ManagerDecision" name="Manager approved?" gatewayDirection="Diverging"><bpmn:incoming>Flow_ManagerDecision</bpmn:incoming><bpmn:outgoing>Flow_ManagerReject</bpmn:outgoing><bpmn:outgoing>Flow_ManagerApprove</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyRejected" name="Notify employee – rejected"><bpmn:extensionElements><zeebe:taskDefinition type="notify-leave-rejection" retries="3"/></bpmn:extensionElements><bpmn:incoming>Flow_ManagerReject</bpmn:incoming><bpmn:outgoing>Flow_RejectedEnd</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ManagerRejected" name="Request rejected"><bpmn:incoming>Flow_RejectedEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_NotifyAutoApproved" name="Notify employee – auto-approved"><bpmn:extensionElements><zeebe:taskDefinition type="notify-leave-approval" retries="3"/></bpmn:extensionElements><bpmn:incoming>Flow_Auto</bpmn:incoming><bpmn:outgoing>Flow_AutoToHR</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RecordHR" name="Forward request to HR"><bpmn:extensionElements><zeebe:taskDefinition type="record-leave-with-hr" retries="3"/></bpmn:extensionElements><bpmn:incoming>Flow_AutoToHR</bpmn:incoming><bpmn:incoming>Flow_ManagerApprove</bpmn:incoming><bpmn:outgoing>Flow_HRToBalance</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateBalance" name="Update employee leave balance"><bpmn:extensionElements><zeebe:taskDefinition type="update-leave-balance" retries="3"/></bpmn:extensionElements><bpmn:incoming>Flow_HRToBalance</bpmn:incoming><bpmn:outgoing>Flow_ApprovedEnd</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Approved" name="Leave approved"><bpmn:incoming>Flow_ApprovedEnd</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_LeaveRequest" targetRef="Task_SubmitRequest"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitRequest" targetRef="Task_CheckBalance"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CheckBalance" targetRef="Task_LeaveDecision"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_LeaveDecision" targetRef="Gateway_LeaveOutcome"/>
    <bpmn:sequenceFlow id="Flow_Insufficient" name="Insufficient balance" sourceRef="Gateway_LeaveOutcome" targetRef="Task_NotifyInsufficient"><bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">= leaveDecision.outcome = "INSUFFICIENT_BALANCE"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto" name="Sick leave ≤ 3 days" sourceRef="Gateway_LeaveOutcome" targetRef="Task_NotifyAutoApproved"><bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">= leaveDecision.outcome = "AUTO_APPROVED"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Manager" name="Manager review required" sourceRef="Gateway_LeaveOutcome" targetRef="Task_ManagerReview"><b:conditionExpression xmlns:b="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="b:tFormalExpression">= leaveDecision.outcome = "MANAGER_REVIEW"</b:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InsufficientEnd" sourceRef="Task_NotifyInsufficient" targetRef="EndEvent_Insufficient"/>
    <bpmn:sequenceFlow id="Flow_ManagerDecision" sourceRef="Task_ManagerReview" targetRef="Gateway_ManagerDecision"/>
    <bpmn:sequenceFlow id="Flow_ManagerReject" name="Rejected" sourceRef="Gateway_ManagerDecision" targetRef="Task_NotifyRejected"><bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">= managerApproved = false</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerApprove" name="Approved" sourceRef="Gateway_ManagerDecision" targetRef="Task_RecordHR"><bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">= managerApproved = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RejectedEnd" sourceRef="Task_NotifyRejected" targetRef="EndEvent_ManagerRejected"/>
    <bpmn:sequenceFlow id="Flow_AutoToHR" sourceRef="Task_NotifyAutoApproved" targetRef="Task_RecordHR"/>
    <bpmn:sequenceFlow id="Flow_HRToBalance" sourceRef="Task_RecordHR" targetRef="Task_UpdateBalance"/>
    <bpmn:sequenceFlow id="Flow_ApprovedEnd" sourceRef="Task_UpdateBalance" targetRef="EndEvent_Approved"/>
  </bpmn:process>
<bpmndi:BPMNDiagram id="BPMNDiagram_Leave"><bpmndi:BPMNPlane id="BPMNPlane_Leave" bpmnElement="employee-leave-approval"><bpmndi:BPMNShape id="Shape_StartEvent_LeaveRequest" bpmnElement="StartEvent_LeaveRequest"><dc:Bounds x="80" y="220" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Task_SubmitRequest" bpmnElement="Task_SubmitRequest"><dc:Bounds x="160" y="205" width="130" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Task_CheckBalance" bpmnElement="Task_CheckBalance"><dc:Bounds x="340" y="205" width="150" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Task_LeaveDecision" bpmnElement="Task_LeaveDecision"><dc:Bounds x="540" y="205" width="170" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Gateway_LeaveOutcome" bpmnElement="Gateway_LeaveOutcome"><dc:Bounds x="770" y="215" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Task_NotifyInsufficient" bpmnElement="Task_NotifyInsufficient"><dc:Bounds x="900" y="35" width="160" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_EndEvent_Insufficient" bpmnElement="EndEvent_Insufficient"><dc:Bounds x="1120" y="52" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Task_ManagerReview" bpmnElement="Task_ManagerReview"><dc:Bounds x="900" y="330" width="170" height="75"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Gateway_ManagerDecision" bpmnElement="Gateway_ManagerDecision"><dc:Bounds x="1140" y="342" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Task_NotifyRejected" bpmnElement="Task_NotifyRejected"><dc:Bounds x="1280" y="465" width="170" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_EndEvent_ManagerRejected" bpmnElement="EndEvent_ManagerRejected"><dc:Bounds x="1510" y="482" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Task_NotifyAutoApproved" bpmnElement="Task_NotifyAutoApproved"><dc:Bounds x="900" y="185" width="180" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Task_RecordHR" bpmnElement="Task_RecordHR"><dc:Bounds x="1280" y="235" width="150" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Task_UpdateBalance" bpmnElement="Task_UpdateBalance"><dc:Bounds x="1490" y="235" width="170" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_EndEvent_Approved" bpmnElement="EndEvent_Approved"><dc:Bounds x="1710" y="252" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1"><di:waypoint x="116" y="238"/><di:waypoint x="160" y="238"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2"><di:waypoint x="290" y="240"/><di:waypoint x="340" y="240"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3"><di:waypoint x="490" y="240"/><di:waypoint x="540" y="240"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4"><di:waypoint x="710" y="240"/><di:waypoint x="770" y="240"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_Insufficient" bpmnElement="Flow_Insufficient"><di:waypoint x="795" y="215"/><di:waypoint x="795" y="70"/><di:waypoint x="900" y="70"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_InsufficientEnd" bpmnElement="Flow_InsufficientEnd"><di:waypoint x="1060" y="70"/><di:waypoint x="1120" y="70"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_Auto" bpmnElement="Flow_Auto"><di:waypoint x="820" y="240"/><di:waypoint x="860" y="240"/><di:waypoint x="860" y="220"/><di:waypoint x="900" y="220"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_Manager" bpmnElement="Flow_Manager"><di:waypoint x="795" y="265"/><di:waypoint x="795" y="367"/><di:waypoint x="900" y="367"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_ManagerDecision" bpmnElement="Flow_ManagerDecision"><di:waypoint x="1070" y="367"/><di:waypoint x="1140" y="367"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_ManagerReject" bpmnElement="Flow_ManagerReject"><di:waypoint x="1165" y="392"/><di:waypoint x="1165" y="500"/><di:waypoint x="1280" y="500"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_RejectedEnd" bpmnElement="Flow_RejectedEnd"><di:waypoint x="1450" y="500"/><di:waypoint x="1510" y="500"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_ManagerApprove" bpmnElement="Flow_ManagerApprove"><di:waypoint x="1190" y="367"/><di:waypoint x="1240" y="367"/><di:waypoint x="1240" y="270"/><di:waypoint x="1280" y="270"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_AutoToHR" bpmnElement="Flow_AutoToHR"><di:waypoint x="1080" y="220"/><di:waypoint x="1180" y="220"/><di:waypoint x="1180" y="270"/><di:waypoint x="1280" y="270"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_HRToBalance" bpmnElement="Flow_HRToBalance"><di:waypoint x="1430" y="270"/><di:waypoint x="1490" y="270"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Flow_ApprovedEnd" bpmnElement="Flow_ApprovedEnd"><di:waypoint x="1660" y="270"/><di:waypoint x="1710" y="270"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
